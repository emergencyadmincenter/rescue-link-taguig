generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AgencyType {
  fire
  medical
  police
  drrmo
  other
}

enum CoordinationStatus {
  pending
  contacted
  completed
}

enum UserStatus {
  pending_activation
  active
  inactive
  removed
}

enum TokenType {
  activation
  password_reset
}

enum TokenStatus {
  active
  used
  revoked
  expired
}

enum LogStatus {
  active
  dispatched
  resolved
  cancelled
}

enum LogSource {
  manual
  voice_call
  chat
}

enum CommunicationMethod {
  voice
  chat
}

enum CallStatus {
  ringing
  active
  ended
  missed
  rejected
}

enum MessageSenderType {
  resident
  coordinator
  system
}

enum MessageType {
  text
  image
  file
}

enum ResourceCategory {
  responder
  medical
  relief
  utility
}

enum FraudRiskClassification {
  low_risk
  high_fraud_risk
}

enum ShadowBanViolationCategory {
  fake_rescue_call
  spam
  fraudulent_activity
  abusive_malicious_use
  impersonation_identity_misuse
  coordinated_system_abuse
  other
}

enum ShadowBanSeverity {
  low
  high
  critical
}

model User {
  id String @id @default(uuid()) @db.Uuid

  name  String
  email String @unique

  password_hash String?

  status UserStatus

  avatar_url   String?
  phone_number String?
  address      String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  removed_at DateTime?

  tokens     UserToken[]
  user_roles UserRole[]

  assigned_logs        Log[]              @relation("AssignedCoordinator")
  created_logs         Log[]              @relation("CreatedByCoordinator")
  calls                Call[]
  log_status_history   LogStatusHistory[]
  shadow_bans          ShadowBan[]
  unbanned_shadow_bans ShadowBan[]        @relation("ShadowBanUnbannedBy")

  created_group_chats    InternalConversation[]            @relation("GroupChatCreator")
  internal_conversations InternalConversationParticipant[] @relation("InternalConversationParticipant")
  sent_internal_messages InternalMessage[]                 @relation("InternalMessageSender")

  log_agency_coordinations LogAgencyCoordination[]

  @@map("users")
}

model Role {
  id String @id @default(uuid()) @db.Uuid

  name        String  @unique
  description String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user_roles       UserRole[]
  role_permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id String @id @default(uuid()) @db.Uuid

  name String @unique

  resource String
  action   String

  description String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  role_permissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  user_id String @db.Uuid
  role_id String @db.Uuid

  assigned_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role Role @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([user_id, role_id])
  @@map("user_roles")
}

model RolePermission {
  role_id       String @db.Uuid
  permission_id String @db.Uuid

  role       Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
  @@map("role_permissions")
}

model UserToken {
  id String @id @default(uuid()) @db.Uuid

  user_id String @db.Uuid
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  type TokenType

  token String @unique

  status TokenStatus

  expires_at DateTime
  created_at DateTime @default(now())

  @@map("user_tokens")
}

model Log {
  id String @id @default(uuid()) @db.Uuid

  reference_no String @unique

  assigned_coordinator_id String? @db.Uuid
  assigned_coordinator    User?   @relation("AssignedCoordinator", fields: [assigned_coordinator_id], references: [id], onDelete: SetNull)

  created_by_coordinator_id String? @db.Uuid
  created_by_coordinator    User?   @relation("CreatedByCoordinator", fields: [created_by_coordinator_id], references: [id], onDelete: SetNull)

  status LogStatus

  source LogSource

  caller_name    String?
  caller_contact String?

  address  String?
  barangay String?

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  location_accuracy  Decimal?  @db.Decimal(10, 2)
  location_timestamp DateTime?
  location_status    String?

  incident_category_id String?           @db.Uuid
  incident_category    IncidentCategory? @relation(fields: [incident_category_id], references: [id], onDelete: SetNull)
  weather_condition    String?

  description String?

  cancellation_reason String?

  last_activity_at DateTime?

  channels String[] @default([])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  resident_visible_until DateTime?

  resolved_at DateTime?

  calls Call[]

  messages Message[]

  resource_assignments LogResourceAssignment[]

  fraud_assessments FraudAssessment[]
  status_history    LogStatusHistory[]

  public_token            String?                 @unique
  public_token_expires_at DateTime?
  logAgencyCoordinations  LogAgencyCoordination[]

  @@index([status])
  @@index([assigned_coordinator_id])
  @@index([created_by_coordinator_id])
  @@index([created_at])
  @@index([source])
  @@map("logs")
}

model LogStatusHistory {
  id String @id @default(uuid()) @db.Uuid

  log_id String @db.Uuid
  log    Log    @relation(fields: [log_id], references: [id], onDelete: Cascade)

  previous_status LogStatus?
  new_status      LogStatus

  changed_by_id String? @db.Uuid
  changed_by    User?   @relation(fields: [changed_by_id], references: [id], onDelete: SetNull)

  remarks    String?
  changed_at DateTime @default(now())

  @@index([log_id, changed_at])
  @@index([changed_by_id])
  @@map("log_status_history")
}

model IncidentCategory {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @unique
  created_at DateTime @default(now())

  logs     Log[]
  agencies AgencyIncidentCategory[]

  @@map("incident_categories")
}

model Resource {
  id String @id @default(uuid()) @db.Uuid

  name String @unique

  category ResourceCategory

  description String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  log_assignments LogResourceAssignment[]

  @@map("resources")
}

model LogResourceAssignment {
  log_id      String @db.Uuid
  resource_id String @db.Uuid

  log Log @relation(fields: [log_id], references: [id], onDelete: Cascade)

  resource Resource @relation(fields: [resource_id], references: [id], onDelete: Cascade)

  @@id([log_id, resource_id])
  @@index([resource_id])
  @@map("log_resource_assignments")
}

model Call {
  id String @id @default(uuid()) @db.Uuid

  log_id String? @db.Uuid
  log    Log?    @relation(fields: [log_id], references: [id], onDelete: Cascade)

  coordinator_id String? @db.Uuid
  coordinator    User?   @relation(fields: [coordinator_id], references: [id], onDelete: SetNull)

  communication_method CommunicationMethod

  status CallStatus

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  location_accuracy  Decimal?  @db.Decimal(10, 2)
  location_timestamp DateTime?
  location_status    String?

  rejection_reason String?

  started_at DateTime @default(now())

  answered_at DateTime?

  ended_at DateTime?

  messages Message[]

  fraud_assessments FraudAssessment[]

  @@index([status])
  @@index([coordinator_id])
  @@index([log_id])
  @@map("calls")
}

model Message {
  id String @id @default(uuid()) @db.Uuid

  log_id String? @db.Uuid
  log    Log?    @relation(fields: [log_id], references: [id], onDelete: Cascade)

  call_id String? @db.Uuid
  call    Call?   @relation(fields: [call_id], references: [id], onDelete: Cascade)

  sender_type MessageSenderType

  type MessageType

  text String?

  attachment_url String?

  image_keys String[]

  created_at DateTime @default(now())

  @@index([log_id])
  @@index([call_id])
  @@index([created_at])
  @@map("messages")
}

model FraudAssessment {
  id String @id @default(uuid()) @db.Uuid

  log_id String? @db.Uuid
  log    Log?    @relation(fields: [log_id], references: [id], onDelete: Cascade)

  call_id String? @db.Uuid
  call    Call?   @relation(fields: [call_id], references: [id], onDelete: Cascade)

  device_uuid      String?
  fingerprint_hash String?

  client_ip String

  ip_latitude  Decimal? @db.Decimal(10, 7)
  ip_longitude Decimal? @db.Decimal(10, 7)
  ip_country   String?
  ip_region    String?
  ip_city      String?

  resident_latitude  Decimal? @db.Decimal(10, 7)
  resident_longitude Decimal? @db.Decimal(10, 7)

  location_permission_granted Boolean @default(true)

  distance_km Decimal? @db.Decimal(10, 2)

  is_vpn     Boolean @default(false)
  is_proxy   Boolean @default(false)
  is_hosting Boolean @default(false)

  risk_classification FraudRiskClassification

  created_at DateTime @default(now())

  @@index([log_id])
  @@index([call_id])
  @@index([created_at])
  @@map("fraud_assessments")
}

model ShadowBan {
  id String @id @default(uuid()) @db.Uuid

  device_uuid      String?
  fingerprint_hash String?
  client_ip        String?
  caller_contact   String?

  reason             String
  violation_category ShadowBanViolationCategory @default(other)
  severity           ShadowBanSeverity          @default(low)
  details            String?
  unban_reason       String?
  unbanned_at        DateTime?

  active Boolean @default(true)

  created_by_id  String? @db.Uuid
  created_by     User?   @relation(fields: [created_by_id], references: [id], onDelete: SetNull)
  unbanned_by_id String? @db.Uuid
  unbanned_by    User?   @relation("ShadowBanUnbannedBy", fields: [unbanned_by_id], references: [id], onDelete: SetNull)

  expires_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([device_uuid])
  @@index([fingerprint_hash])
  @@index([client_ip])
  @@index([active])
  @@index([violation_category])
  @@index([severity])
  @@map("shadow_bans")
}

model QuarantinedEmergencyRequest {
  id String @id @default(uuid()) @db.Uuid

  original_payload Json

  device_uuid      String?
  fingerprint_hash String?
  client_ip        String?

  resident_latitude    Decimal?  @db.Decimal(10, 7)
  resident_longitude   Decimal?  @db.Decimal(10, 7)
  location_accuracy    Decimal?  @db.Decimal(10, 2)
  location_timestamp   DateTime?
  location_status      String?
  communication_method String?

  shadow_ban_reason String?

  created_at DateTime @default(now())

  @@index([device_uuid])
  @@index([fingerprint_hash])
  @@index([created_at])
  @@map("quarantined_emergency_requests")
}

model InternalConversation {
  id String @id @default(uuid()) @db.Uuid

  is_group Boolean @default(false)
  title    String?

  created_by_id String? @db.Uuid
  created_by    User?   @relation("GroupChatCreator", fields: [created_by_id], references: [id], onDelete: SetNull)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  participants InternalConversationParticipant[]
  messages     InternalMessage[]

  @@map("internal_conversations")
}

model InternalConversationParticipant {
  conversation_id String @db.Uuid
  user_id         String @db.Uuid

  conversation InternalConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  user         User                 @relation("InternalConversationParticipant", fields: [user_id], references: [id], onDelete: Cascade)

  joined_at    DateTime @default(now())
  last_read_at DateTime @default(now())
  is_muted     Boolean  @default(false)

  @@id([conversation_id, user_id])
  @@index([user_id])
  @@map("internal_conversation_participants")
}

model InternalMessage {
  id String @id @default(uuid()) @db.Uuid

  conversation_id String               @db.Uuid
  conversation    InternalConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  sender_id String? @db.Uuid
  sender    User?   @relation("InternalMessageSender", fields: [sender_id], references: [id], onDelete: SetNull)

  text       String?
  image_keys String[]

  reply_to_id String?           @db.Uuid
  reply_to    InternalMessage?  @relation("MessageReplies", fields: [reply_to_id], references: [id], onDelete: SetNull)
  replies     InternalMessage[] @relation("MessageReplies")

  created_at DateTime @default(now())

  @@index([conversation_id])
  @@index([created_at])
  @@map("internal_messages")
}

model Agency {
  id           String     @id @default(uuid()) @db.Uuid
  name         String     @unique
  type         AgencyType
  contact_info String?
  is_active    Boolean    @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  incident_categories AgencyIncidentCategory[]
  log_coordinations   LogAgencyCoordination[]

  @@map("agencies")
}

model AgencyIncidentCategory {
  agency_id            String @db.Uuid
  incident_category_id String @db.Uuid

  agency            Agency           @relation(fields: [agency_id], references: [id], onDelete: Cascade)
  incident_category IncidentCategory @relation(fields: [incident_category_id], references: [id], onDelete: Cascade)

  @@id([agency_id, incident_category_id])
  @@map("agency_incident_categories")
}

model LogAgencyCoordination {
  id String @id @default(uuid()) @db.Uuid

  log_id String @db.Uuid
  log    Log    @relation(fields: [log_id], references: [id], onDelete: Cascade)

  agency_id String @db.Uuid
  agency    Agency @relation(fields: [agency_id], references: [id], onDelete: Cascade)

  status  CoordinationStatus @default(pending)
  remarks String?

  created_by_id String? @db.Uuid
  created_by    User?   @relation(fields: [created_by_id], references: [id], onDelete: SetNull)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([log_id, agency_id])
  @@map("log_agency_coordinations")
}
